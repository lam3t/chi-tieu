# NextAuth / Auth.js configuration
AUTH_SECRET="your-generated-auth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials (Console: https://console.cloud.google.com/)
# Scopes needed: openid email profile https://www.googleapis.com/auth/drive.appdata
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Anthropic API Key for Receipt OCR (used exclusively in /api/ocr)
ANTHROPIC_API_KEY="sk-ant-api03-..."
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
